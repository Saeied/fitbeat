{
  "name": "dance-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "dev:test": "node scripts/use-env.mjs test && next dev --hostname 0.0.0.0",
    "dev:production": "node scripts/use-env.mjs production && next dev --hostname 0.0.0.0",
    "build": "next build",
    "build:tv": "node scripts/build-tv.mjs",
    "build:tv:test": "node scripts/build-tv.mjs test",
    "build:tv:production": "node scripts/build-tv.mjs production",
    "deploy:tv:prod": "node scripts/deploy-tv-prod.mjs",
    "verify:video-range": "node scripts/verify-video-range.mjs",
    "verify:catalog": "node scripts/verify-catalog.mjs",
    "verify:tv-css": "node scripts/verify-tv-css.mjs",
    "verify:player-profile": "npx --yes tsx scripts/verify-player-profile-runner.ts",
    "pack:server": "node scripts/pack-for-server.mjs",
    "preview": "node scripts/serve-out.mjs",
    "preview:test": "node scripts/build-tv.mjs test --no-deploy && node scripts/serve-out.mjs",
    "start": "node scripts/serve-out.mjs",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "browserslist": [
    "chrome >= 69",
    "safari >= 12"
  ],
  "dependencies": {
    "next": "16.3.0",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@csstools/postcss-color-mix-function": "^4.0.10",
    "@csstools/postcss-oklab-function": "^5.0.10",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "eslint-config-prettier": "^10.1.8",
    "postcss-flexbugs-fixes": "^5.0.2",
    "postcss-preset-env": "^11.5.1",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
