# Nakama — سرور پروداکشن (85.198.11.216)
NEXT_PUBLIC_NAKAMA_HTTP_URL=http://85.198.11.216:7350
NEXT_PUBLIC_NAKAMA_WS_URL=ws://85.198.11.216:7350
NEXT_PUBLIC_NAKAMA_SERVER_KEY=e6f10428957017d3dfff463c7b81c5b3
# ویدیوها: /var/www/html/dance_Content → http://IP/dance_Content/...
NEXT_PUBLIC_NAKAMA_MEDIA_HTTP_URL=http://85.198.11.216

# مسیر وب روی Apache (http://IP/dc/)
NEXT_PUBLIC_BASE_PATH=/dc

# ——— فقط برای deploy (اسکریپت build:tv) ———
DEPLOY_HOST=85.198.11.216
DEPLOY_USER=root
# مستقیم زیر DocumentRoot → http://IP/dc/ بدون Alias
DEPLOY_PATH=/var/www/html/dc
DEPLOY_RELEASES_PATH=/var/www/html/deploy-tv/releases

# عیب‌یابی ویدیو روی TV — TV_VIDEO_DIAG() در console
NEXT_PUBLIC_VIDEO_DEBUG=1
# legacy = TV/Android Box: prefers explicit 720/480 from Nakama when present
NEXT_PUBLIC_VIDEO_DEVICE_TIER=legacy
# Preload buffer gate for existing server MP4 (no video file changes).
# video_001 ≈ 146s / 45MB → default 12% waited ~17.5s; 5% ≈ 7.3s before tvReady.
NEXT_PUBLIC_VIDEO_BUFFER_MIN_SECONDS=5
NEXT_PUBLIC_VIDEO_BUFFER_MIN_RATIO=0.05
NEXT_PUBLIC_VIDEO_PRELOAD_STALL_MS=20000
NEXT_PUBLIC_VIDEO_PRELOAD_STALL_MIN_SECONDS=5
# فقط وقتی فایل‌های nested روی سرور هست: video_001/720/video_001.mp4
NEXT_PUBLIC_VIDEO_NESTED_VARIANTS=0
